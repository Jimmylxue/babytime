{
	"name": "baby-time",
	"version": "1.0.0",
	"private": true,
	"description": "育娃手记 - 婴儿日常记录工具",
	"scripts": {
		"dev:client": "npm --prefix apps/client run dev",
		"dev:server": "npm --prefix apps/server run start:dev",
		"dev:admin": "npm --prefix apps/admin run dev",
		"build:client": "npm --prefix apps/client run build",
		"build:server": "npm --prefix apps/server run build",
		"build:admin": "npm --prefix apps/admin run build",
		"build": "npm run build:admin && npm run build:server && npm run build:client"
	},
	"devDependencies": {
		"typescript": "^5.4.5"
	},
	"engines": {
		"node": ">=18.0.0"
	},
	"packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
