# ============ 数据库配置 ============
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_password
DB_DATABASE=baby_time
# TypeORM 自动同步表结构。留空时按 NODE_ENV 推断：production=false，其余=true。
# 生产务必保持关闭（或显式写 false）：改实体字段名/删字段时自动 ALTER 会直接丢数据，
# 表结构变更一律走 docs/sql/*.sql + run-sql.sh。详见 docs/db-backup-and-migration.md
# DB_SYNCHRONIZE=false

# ============ JWT ============
JWT_SECRET=your-super-secret-jwt-key

# ============ 管理后台 ============
# 后台访问地址: http://服务地址:PORT/admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=please-change-me
# 管理后台 JWT 独立密钥，请改成足够长的随机字符串
ADMIN_JWT_SECRET=change-me-to-a-long-random-string
# 可选，管理后台前端构建产物目录（默认 apps/admin/dist）
# ADMIN_DIST_PATH=

# ============ 智谱视觉识别（宝宝便便观察） ============
# 请仅在服务端填写，绝不能放入小程序客户端配置或提交到 Git。
ZHIPU_API_KEY=
# 可选，默认 glm-4v-flash
ZHIPU_VISION_MODEL=glm-4v-flash

# ============ 微信小程序 ============
WECHAT_APP_ID=your_wechat_app_id
WECHAT_APP_SECRET=your_wechat_app_secret

# 小程序代码上传密钥文件路径（用于 mini.sh 部署脚本）
PRIVATE_KEY_PATH=.miniprogram.key

# ============ 文件上传 ============
# 上传驱动: local | upyun
UPLOAD_DRIVER=local

# 又拍云配置（UPLOAD_DRIVER=upyun 时需要）
UPYUN_OPERATOR=
UPYUN_PASSWORD=
UPYUN_BUCKET=
UPYUN_DOMAIN=https://xxx.upcdn.net

# ============ 家庭邀请卡 ============
# 邀请卡有效期（天），默认 7；本地测试时可调小（如 0.002 ≈ 3 分钟）验证过期逻辑
FAMILY_INVITE_EXPIRE_DAYS=7

# ============ 微信订阅消息 ============
# 在微信公众平台申请模板后填写；模板 ID 留空则该类提醒整体关闭。
# 这里的字段名默认值与代码里的 fallback 逐字对齐（vaccine-reminder.service.ts），
# 填错微信会返回 47003 参数错误，消息发不出去且用户侧毫无感知，
# 只在 notification_deliveries 里记成 failed —— 改完务必用后台「订阅与唤回」直推一条验证。

# --- 疫苗倒计时提醒（模板编号 54900）---
# 模板 ID 形如 40 位字符串，从微信公众平台「订阅消息 → 我的模板」复制，不要提交真值进仓库
WECHAT_SUBSCRIBE_VACCINE_TEMPLATE_ID=
WECHAT_SUBSCRIBE_MINI_PROGRAM_STATE=formal
VACCINE_REMINDER_DAYS=3
VACCINE_REMINDER_HOUR=9
# 字段名必须与所选模板的关键词一致：thing=文本 / number=数字 / time=时间 / date=日期 / phrase=拼音
# 时间类字段要 24 小时制（发送时拼成 "YYYY-MM-DD HH:mm"），date 类过不了校验
WECHAT_VACCINE_FIELD_NAME=thing1
WECHAT_VACCINE_FIELD_DATE=time2
WECHAT_VACCINE_FIELD_NOTE=thing6

# --- 每日回顾（模板编号 77947「宝宝每日奶粉消耗提醒」）---
WECHAT_SUBSCRIBE_REVIEW_TEMPLATE_ID=
# number2 是数字类型字段，只能传纯数字，带「次」会被判参数非法
WECHAT_REVIEW_FIELD_BABY=thing1
WECHAT_REVIEW_FIELD_FEEDING=number2
WECHAT_REVIEW_FIELD_DATE=time3
# 推送时刻（整点，服务器本地时区）；留空按 21 点 —— 宝宝哄睡后、妈妈刷手机的黄金时段
DAILY_REVIEW_HOUR=21

# ============ 客户端 API 地址 ============
# 开发环境默认 http://localhost:3000，生产环境必须配置
API_BASE_URL=http://localhost:3000

# ============ 服务端口 ============
PORT=3000
# 只在本机自检时才需要限制绑定网卡（部署前探活的临时实例用 127.0.0.1，
# 免得那几秒在 0.0.0.0 上多开一个可达端口）。
# ⚠️ 生产不要设这个变量：留空才会走 Node 默认的双栈监听（::），
# 写死 0.0.0.0 反而可能丢掉 ::，nginx 若按 ::1 回源就连不上了。
# LISTEN_HOST=127.0.0.1

# ============ 运维看板 ============
# 主域注册到期日，后台「运维看板」算倒计时用。续费后改这一行即可。
# 留空则页面显示"未配置"，不影响其他功能。
OPS_DOMAIN_EXPIRY=2027-10-17
# Server酱 微信推送：sct.ftqq.com 微信扫码登录后拿的 SendKey（形如 SCTxxxxx），留空则告警只写日志不推送。
# 免费档每天 5 条，本告警正常一天最多 1 条。
SERVERCHAN_KEY=
# 告警接口的调用凭据：自己生成一个（openssl rand -hex 32），crontab 里带上。
# 留空 = POST admin/ops/alert-check 直接 503 禁用，不会敞开一个无凭据的公网写接口。
OPS_ALERT_TOKEN=
# 部署前探活用：设成 1 的进程不启动订阅消息定时器（apps/server/scripts/deploy-preflight.js
# 会自动带上，因为它连的是真库、拿的是真模板 ID，不禁掉就会真发消息、真扣用户额度）。
# 正常服务端 .env 里不要设这个变量 —— 设了疫苗提醒和每日回顾就再也不推送了。
# OPS_DISABLE_SCHEDULER=1
