# ============ 数据库配置 ============
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_password
DB_DATABASE=baby_time

# ============ JWT ============
JWT_SECRET=your-super-secret-jwt-key

# ============ 管理后台 ============
# 后台访问地址: http://服务地址:PORT/admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=please-change-me
# 管理后台 JWT 独立密钥，请改成足够长的随机字符串
ADMIN_JWT_SECRET=change-me-to-a-long-random-string
# 可选，管理后台前端构建产物目录（默认 apps/admin/dist）
# ADMIN_DIST_PATH=

# ============ 智谱视觉识别（宝宝便便观察） ============
# 请仅在服务端填写，绝不能放入小程序客户端配置或提交到 Git。
ZHIPU_API_KEY=
# 可选，默认 glm-4v-flash
ZHIPU_VISION_MODEL=glm-4v-flash

# ============ 微信小程序 ============
WECHAT_APP_ID=your_wechat_app_id
WECHAT_APP_SECRET=your_wechat_app_secret

# 小程序代码上传密钥文件路径（用于 mini.sh 部署脚本）
PRIVATE_KEY_PATH=.miniprogram.key

# ============ 文件上传 ============
# 上传驱动: local | upyun
UPLOAD_DRIVER=local

# 又拍云配置（UPLOAD_DRIVER=upyun 时需要）
UPYUN_OPERATOR=
UPYUN_PASSWORD=
UPYUN_BUCKET=
UPYUN_DOMAIN=https://xxx.upcdn.net

# ============ 家庭邀请卡 ============
# 邀请卡有效期（天），默认 7；本地测试时可调小（如 0.002 ≈ 3 分钟）验证过期逻辑
FAMILY_INVITE_EXPIRE_DAYS=7

# ============ 客户端 API 地址 ============
# 开发环境默认 http://localhost:3000，生产环境必须配置
API_BASE_URL=http://localhost:3000

# ============ 服务端口 ============
PORT=3000
